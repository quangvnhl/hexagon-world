# Mẫu env cho node GAME — chỉ tên biến, KHÔNG giá trị (AGENTS.md §1).
#
# ┌─ DANH SÁCH NÀY NGẮN LÀ CÓ CHỦ Ý ────────────────────────────────────────────────────────┐
# │ Node game nhận WebSocket từ Internet nên nó là thứ dễ bị chiếm nhất trong hệ. Nó KHÔNG   │
# │ cần khoá Supabase, token Telegram hay OAuth secret để làm việc của mình, nên nó không    │
# │ được cấp. `release-gate.mjs` TỪ CHỐI một game env có bất kỳ biến nào trong số đó, và     │
# │ `scripts/compose.test.mjs` từ chối một file compose lén đưa chúng vào.                   │
# └────────────────────────────────────────────────────────────────────────────────────────┘

NODE_ENV=
SERVER_ROLE=
PORT=

GAME_REGION=
# URL HTTPS công khai của control plane.
CONTROL_PLANE_URL=
# Khoá CÔNG KHAI tương ứng với REGION_TICKET_PRIVATE_KEY_BASE64 của control plane.
REGION_TICKET_PUBLIC_KEY_BASE64=
# Phải khớp control plane.
GAME_RESULT_SECRET=
# Phải khớp GAME_PROTOCOL_VERSION trong packages/shared/src/protocol-version.ts.
GAME_PROTOCOL_VERSION=

# Đây là TIỀN của người chơi khi control plane chưa nhận được kết quả trận. Giá trị này phải
# nằm trong volume `game-spool` mà docker-compose.yml gắn vào, nếu không một lần deploy là mất
# sạch. `scripts/compose.test.mjs` giữ ràng buộc đó.
GAME_RESULT_SPOOL_DIR=

# KHÔNG cần GAME_PUBLIC_WS_URL / GAME_PUBLIC_PING_URL / GAME_REGION_NAME ở đây.
# `runtime-config.ts` chỉ đọc chúng để dựng một danh sách region DỰ PHÒNG khi
# GAME_REGIONS_JSON rỗng, mà danh sách region chỉ được control plane dùng
# (`GET /v1/regions` và lúc cấp vé khách). Node game chỉ cần biết CHÍNH NÓ là region nào,
# tức GAME_REGION ở trên. Khai thêm ở đây là thêm hai chỗ có thể lệch nhau mà không ai kiểm.
