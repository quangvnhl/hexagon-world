# Mẫu env cho node CONTROL PLANE — chỉ tên biến, KHÔNG giá trị (AGENTS.md §1).
# Chép thành deploy/control.env TRÊN MÁY CHỦ rồi điền. `.gitignore` đã chặn deploy/*.env.
# Điền xong kiểm bằng:
#   node scripts/release-gate.mjs --target production --control deploy/control.env --game deploy/game.env
#
# Cổng đó từ chối placeholder, từ chối URL trỏ localhost, đòi secret tối thiểu 32 byte, và đối
# chiếu vân tay khoá công khai của node game với khoá riêng ở đây.

NODE_ENV=
SERVER_ROLE=
PORT=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
PLAYER_SESSION_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_POST_LOGIN_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Khoá RIÊNG ký region ticket. Node game chỉ nhận khoá CÔNG KHAI tương ứng.
REGION_TICKET_PRIVATE_KEY_BASE64=

# Dùng chung với node game — hai bên phải khớp, release-gate kiểm điều đó.
GAME_RESULT_SECRET=

ADMIN_API_KEY_SHA256=

# JSON mảng region. Mỗi phần tử cần id, name, wsUrl (wss://.../game), pingUrl (https://.../health/ping).
GAME_REGIONS_JSON=

# Danh sách origin HTTPS, phân tách bằng dấu phẩy, không có path.
CORS_ALLOWED_ORIGINS=
