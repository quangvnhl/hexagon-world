# Hexagon World - copy this file to .env and replace placeholder secrets.
# Never expose the variables in this server-only section with NEXT_PUBLIC_*.

# Runtime / Docker
NODE_ENV=development
PORT=8910
CLIENT_PORT=3890
SERVER_PORT=8910
ENTITY_AOI_RADIUS=60
MAX_ONLINE_PLAYERS=8
# Số bot cố định mỗi room; server clamp trong khoảng 12..16.
MAX_PLAYERS=12
ONLINE_BOT_JOIN_INTERVAL_MS=1500
KING_ROOM_DURATION_SECONDS=180
# Territory rendered around the camera; hysteresis retains edge cells while panning.
TERRITORY_AOI_RADIUS=48
TERRITORY_AOI_HYSTERESIS=10
# Drop/coalesce hot-path frames for sockets with this many queued bytes.
WS_BACKPRESSURE_BYTES=262144
# Must match the client build; bump only for incompatible wire changes.
GAME_PROTOCOL_VERSION=4
NEXT_PUBLIC_SERVER_URL=ws://localhost:8910
NEXT_PUBLIC_API_URL=http://localhost:8910
# Public AdsGram identifiers. AdsGram SDK is loaded only after Telegram platform gating.
NEXT_PUBLIC_ADSGRAM_REWARDED_LOBBY_RANDOM_BLOCK_ID=
NEXT_PUBLIC_ADSGRAM_INTERSTITIAL_END_GAME_BLOCK_ID=int-42587
CORS_ALLOWED_ORIGINS=http://localhost:3890,http://127.0.0.1:3890

# Supabase (server only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SERVER_KEY
# Optional legacy fallback only; prefer SUPABASE_SECRET_KEY for new projects.
SUPABASE_SERVICE_ROLE_KEY=
# Used by migrations/administration, not by browser or normal game requests.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_HOST:5432/postgres
SUPABASE_DB_SCHEMA=public
SUPABASE_REQUEST_TIMEOUT_MS=5000
# false: game remains available if persistence is temporarily unavailable.
SUPABASE_PERSISTENCE_REQUIRED=false

# Player authentication (server only)
# Generate at least 32 random bytes; rotate through a planned session migration.
PLAYER_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
PLAYER_SESSION_TTL_SECONDS=86400

# Google OAuth 2.0 web-server flow (control plane only)
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_WEB_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8910/v1/auth/web/google/callback
GOOGLE_OAUTH_POST_LOGIN_REDIRECT_URI=http://localhost:3890
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_OAUTH_STATE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
TELEGRAM_STARS_ENABLED=true

# Source attribution
PLAYER_SOURCE_DEFAULT=web
PLAYER_SOURCE_ALLOWLIST=web,telegram

# Shop / inventory
SHOP_DEFAULT_CURRENCY=coin
SHOP_CATALOG_CACHE_TTL_SECONDS=60
SHOP_PURCHASE_IDEMPOTENCY_TTL_SECONDS=86400
DEFAULT_FREE_ITEMS_PER_CATEGORY=1
DEFAULT_FREE_COLOR_ASSET_KEY=color:0
DEFAULT_FREE_SHAPE_ASSET_KEY=shape:cube
DEFAULT_FREE_TRAIL_ASSET_KEY=trail:solid

# Data retention
MATCH_HISTORY_RETENTION_DAYS=30

# Admin/internal APIs (store only hashes/secrets, never expose to client)
# Generate an admin token, then store its lowercase SHA-256 digest here.
ADMIN_API_KEY_SHA256=REPLACE_WITH_SHA256_OF_ADMIN_TOKEN
GAME_RESULT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
GAME_RESULT_SPOOL_DIR=/app/data/match-results

# Deployment topology. Use "all" for local Docker; production can run
# "control" separately from one or more regional "game" deployments.
SERVER_ROLE=all
GAME_REGION=local
GAME_REGION_NAME=Local
CONTROL_PLANE_URL=http://localhost:8910
GAME_PUBLIC_WS_URL=ws://localhost:8910/game
GAME_PUBLIC_PING_URL=http://localhost:8910/health/ping
# Production example: [{"id":"sg","name":"Singapore","wsUrl":"wss://sg.game.example.com/game","pingUrl":"https://sg.game.example.com/health/ping"}]
GAME_REGIONS_JSON=
# Control plane signs short-lived regional join tickets; game nodes verify them.
REGION_TICKET_PRIVATE_KEY_BASE64=REPLACE_ON_CONTROL_PLANE_ONLY
REGION_TICKET_PUBLIC_KEY_BASE64=REPLACE_ON_GAME_SERVERS
REGION_TICKET_TTL_SECONDS=60
