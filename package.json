{
  "name": "hexagon-world",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build:shared": "pnpm --filter @hexagon/shared build",
    "build": "pnpm --filter @hexagon/shared build && pnpm --filter @hexagon/server build && pnpm --filter @hexagon/client build",
    "typecheck": "pnpm --filter @hexagon/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "release:check": "node scripts/release-gate.mjs",
    "test:release-gate": "node --test scripts/release-gate.test.mjs",
    "test:db-migrate": "node --test scripts/db-migrate.test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:db-seed": "node --test scripts/db-seed.test.mjs",
    "test:dockerfile": "node --test scripts/dockerfile.test.mjs",
    "test:compose": "node --test scripts/compose.test.mjs",
    "test:env-example": "node --test scripts/env-example.test.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "test:review-guard": "node --test scripts/review-guard.test.mjs",
    "review:guard": "node scripts/review-guard.mjs",
    "review:collect": "node scripts/review-collect.mjs",
    "test:review-collect": "node --test scripts/review-collect.test.mjs",
    "verify:logic": "pnpm --filter @hexagon/shared verify:logic",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "dev:client": "pnpm --filter @hexagon/client dev",
    "dev:server": "pnpm --filter @hexagon/server start:dev",
    "dev:admin": "pnpm --filter @hexagon/admin dev",
    "build:admin": "pnpm --filter @hexagon/admin build",
    "test:integration": "pnpm --filter @hexagon/server test:integration",
    "test:e2e:smoke": "playwright test --config playwright.config.ts",
    "test:e2e:money": "playwright test --config playwright.money.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "pg": "^8.23.0",
    "typescript": "^5.7.0"
  }
}
